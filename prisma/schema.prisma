// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles: ADMIN, MANAGER, SALES_EXECUTIVE, CONTENT_MANAGER
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("SALES_EXECUTIVE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  activities   ActivityLog[]
  enquiries    Enquiry[]     @relation("AssignedStaff")
  leads        Lead[]        @relation("AssignedAgent")
}

model Category {
  id              String     @id @default(uuid())
  slug            String     @unique
  title           String
  description     String
  heroTagline     String
  longDescription String
  highlights      String     @default("[]") // JSON stringified array
  idealFor        String     @default("[]") // JSON stringified array
  tone            String     @default("warm")
  properties      Property[]
  brochures       Brochure[]
  requirementOf   Enquiry[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// A brochure is a downloadable/viewable PDF the CRM attaches to a
// property category (e.g. "Bank Auction Property Guide" under Bank
// Auctions) — deliberately its own model, not a Property: it's category
// -level marketing collateral, not a listing, and must never be mixed
// into the property grid on the public site.
model Brochure {
  id           String   @id @default(uuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title        String
  description  String? // optional per spec — never required to publish
  fileUrl      String // Supabase Storage public URL (PDF)
  thumbnailUrl String? // optional cover image, Supabase Storage public URL
  order        Int      @default(0) // admin-controlled display order within its category
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
}

model Builder {
  id         String     @id @default(uuid())
  name       String     @unique
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Admin-managed list of property types (Independent Building, Flat, Villa,
// Site, ...) — same pattern as Builder: a real table with its own CRUD
// screen (/admin/property-types) rather than a hardcoded dropdown, so
// staff can add/remove options without a code change.
model PropertyType {
  id         String     @id @default(uuid())
  name       String     @unique
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Property statuses: PUBLISHED, UNPUBLISHED, ARCHIVED, SOLD, UNDER_PROCESS, AUCTION_CLOSED
model Property {
  id             String   @id @default(uuid())
  propertyId     String   @unique // Auto-generated short ID (e.g. SH-1001)
  slug           String   @unique
  title          String
  location       String
  price          String
  priceValueLakh Float
  status         String   @default("UNPUBLISHED")
  featured       String   @default("false") // "true" or "false"
  beds           Int
  baths          Int
  area           String
  areaSqft       Int
  description    String
  address        String
  mapQuery       String
  views          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Listing details (99acres / Housing.com style) -----------------
  // All additive: every column is nullable or has a default, so existing
  // rows and the bulk-import path (which writes Property directly) are
  // unaffected. `area`/`areaSqft` above remain the headline area; the
  // columns below are the finer breakdown. Select-style fields hold the
  // option strings defined in src/lib/propertyDetails.ts.
  purpose            String  @default("Sale") // Sale | Rent
  ownershipType      String? // Freehold | Leasehold
  availabilityStatus String? // Ready to Move | Under Construction
  possessionDate     String? // YYYY-MM-DD; only meaningful when Under Construction

  locality         String?
  city             String  @default("Bengaluru")
  pincode          String? // 6 digits
  landmark         String?
  nearbyFacilities String  @default("[]") // JSON stringified array

  plotArea    Float? // sqft
  builtUpArea Float? // sqft
  carpetArea  Float? // sqft
  dimLength   Float? // ft
  dimWidth    Float? // ft
  roadWidth   Float? // ft

  totalFloors  String? // free text, e.g. "Ground + 4"
  floorDetails String?
  balconies    Int?
  parkingCars  Int?
  parkingBikes Int?
  propertyAge  String?
  furnishing   String? // Unfurnished | Semi-Furnished | Fully Furnished
  facing       String? // East | West | North | South | North-East | ...

  waterSupply String?
  electricity String?
  lift        String? // Yes | No
  powerBackup String? // None | Partial | Full
  amenities   String  @default("[]") // JSON stringified array

  // Full rupee amount (NOT lakhs). price/priceValueLakh above are still
  // what the public site filters and displays on; this is the exact figure.
  expectedPrice Float?
  negotiable    String? // Yes | No

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Optional: a listing can exist before a builder is confirmed/
  // assigned (or simply have none, e.g. an individual resale). Was a
  // required FK — relaxed so the wizard's Builder field can offer a
  // real "None" option instead of forcing a pick.
  builderId String?
  builder   Builder? @relation(fields: [builderId], references: [id], onDelete: SetNull)

  // Physical property type (Independent Building, Flat, Villa, Site, ...)
  // — an admin-managed relation, not a hardcoded string list. Distinct
  // from categoryId/category above: category is the investment/deal
  // classification (bank auction, resale, rental income, ...) used for
  // the public site's routing and filtering; this is what kind of
  // structure the listing actually is.
  propertyTypeId String
  propertyType   PropertyType @relation(fields: [propertyTypeId], references: [id])

  // Auction details (optional)
  auctionInfo AuctionInfo?

  // Loan eligibility details
  loanEligibility LoanEligibility?

  // Relations
  images    PropertyImage[]
  videos    PropertyVideo[]
  documents Document[]
  enquiries Enquiry[]
  // CRM deals closed against this listing (see Lead.propertyId).
  leads     Lead[]          @relation("LeadProperty")

  // status/featured/createdAt are filtered and sorted on in nearly every
  // public + CRM property query (getPublishedProperties, dashboard
  // counts, admin listing) — indexed so those stay fast as the table
  // grows past today's small row count.
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model AuctionInfo {
  id                 String   @id @default(uuid())
  propertyId         String   @unique
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bankName           String
  auctionDate        DateTime
  emd                String
  reservePrice       String
  physicalPossession Boolean  @default(false)
  legalStatus        String
}

model LoanEligibility {
  id            String   @id @default(uuid())
  propertyId    String   @unique
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  maxLoanAmount String
  indicativeEmi String
  partnerBanks  String   @default("[]") // JSON stringified array
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String
  publicId   String // Cloudinary reference
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyVideo {
  id         String   @id @default(uuid())
  url        String
  publicId   String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Document {
  id         String   @id @default(uuid())
  name       String
  url        String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  message    String
  status     String   @default("NEW") // NEW, CONTACTED, FOLLOW_UP, CONVERTED, CLOSED
  notes      String?
  staffId    String?
  assignedTo User?    @relation("AssignedStaff", fields: [staffId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Added for the public-site "Request a Consultation" flow — reuses
  // this existing Enquiry model rather than a separate table (every
  // consultation IS an enquiry: same customer/property relationship,
  // same CRM list, same status lifecycle). All four are optional so
  // existing rows and any other future Enquiry source (a plain contact
  // form with no scheduling concept) are unaffected.
  enquiryType   String  @default("General") // "General" | "Consultation"
  contactMethod String? // "Phone" | "WhatsApp" | "Email"
  preferredDate String?
  preferredTime String?

  // What the client is actually asking for, captured by staff after
  // talking to them — separate from `property` above, which is just
  // whichever single listing they clicked "Consultation" on (or none,
  // for a general contact-form enquiry). Structured (bedrooms +
  // category) specifically so the CRM can count/show which live
  // listings actually match, not just store it as more free text.
  // Both optional — filling this in is never required to process an
  // enquiry.
  requirementBedrooms   Int?
  requirementCategoryId String?
  requirementCategory   Category? @relation(fields: [requirementCategoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([enquiryType])
  @@index([requirementCategoryId])
}

model Customer {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String    @unique
  enquiries Enquiry[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  location    String?
  quote       String
  rating      Int      @default(5)
  imagePublic String?
  // Every existing row predates this field and defaults to true, so
  // nothing currently visible on the homepage disappears when this
  // ships — the toggle only affects testimonials added/edited after.
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published])
}

model Blog {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  content        String
  featuredImage  String
  seoTitle       String?
  seoDescription String?
  seoKeywords    String   @default("[]") // JSON stringified array
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  id           String @id @default(uuid())
  companyName  String @default("Sarakki Homes")
  companyLogo  String @default("/logo.png")
  favicon      String @default("/favicon.ico")
  smtpHost     String @default("")
  smtpPort     Int    @default(587)
  smtpUser     String @default("")
  smtpPassword String @default("")
  whatsappNo   String @default("+91 98450 00000")
  instagramUrl String @default("#")
  linkedinUrl  String @default("#")
  metaTitle    String @default("Sarakki Homes")
  metaDesc     String @default("")
  
  // CMS Fields
  heroTitle       String @default("Trust before property.")
  heroDescription String @default("From bank auctions to ready-to-move homes, we guide every step — legal verification, financing, registration, khata transfer — so your investment is never a leap of faith.")
  aboutHeadline   String @default("BENGALURU'S TRUSTED PROPERTY CONSULTANCY")
  aboutDescription String @default("We guide clients through selection, verification, bidding, and registration. Experience a seamless and secure transaction experience.")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String
  createdAt DateTime @default(now())
}

// ============================================================
// CRM — core lead-management module, modeled loosely on the
// client-supplied reference CRM (RAYYAN01/realestatecrm) but kept on
// this project's existing Prisma + SQLite + NextAuth stack rather than
// migrating to Supabase. Phase 1 scope: leads, pipeline stage, tasks,
// notes, and an activity timeline. Deliberately separate from the
// pre-existing Enquiry/Customer models — those stay as the public
// website's contact-form pipeline; Lead is the CRM's own richer record,
// added by staff (walk-ins, calls, referrals) as well as manually
// promoted from an Enquiry.
// ============================================================

// Pipeline stages: NEW, CONTACTED, QUALIFIED, SITE_VISIT, NEGOTIATION, WON, LOST
model Lead {
  id            String    @id @default(uuid())
  name          String
  phone         String
  email         String?
  location      String?
  budgetMinLakh Float?
  budgetMaxLakh Float?
  propertyType  String?
  purpose       String    @default("Buy") // Buy, Rent, Invest
  source        String    @default("Website")
  bedrooms      Int?
  bathrooms     Int?
  areaRequired  String?
  possession    String? // Ready to Move, Under Construction, Any
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  stage         String    @default("NEW")
  favorite      Boolean   @default(false)
  wonDetails    String?
  lostReason    String?
  lastContact   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // --- Deal / revenue tracking -------------------------------------
  // All amounts are in lakh (₹), matching the existing budget*Lakh and
  // Property.priceValueLakh convention so nothing needs unit conversion
  // when comparing a lead's budget to the deal it actually closed at.
  //
  // dealValueLakh   = the transaction size (what the property sold for)
  // commissionPct   = Sarakki Homes' cut, as a percentage of the deal
  // commissionLakh  = the actual earned revenue. Stored rather than
  //                   always derived, because a negotiated/flat fee can
  //                   differ from a straight percentage — the UI
  //                   pre-fills it from the percentage but allows an
  //                   override, and reports read this field.
  // closedAt        = when the lead reached WON or LOST. Distinct from
  //                   updatedAt (which any edit touches), so
  //                   revenue-by-period reporting stays accurate.
  dealValueLakh  Float?
  commissionPct  Float?
  commissionLakh Float?
  closedAt       DateTime?

  // The specific listing this deal was closed on, when applicable.
  // Optional: plenty of leads are closed on off-listing or
  // yet-to-be-listed inventory, and a lead exists long before any
  // property is chosen.
  propertyId String?
  property   Property? @relation("LeadProperty", fields: [propertyId], references: [id], onDelete: SetNull)

  agentId String?
  agent   User?   @relation("AssignedAgent", fields: [agentId], references: [id])

  tasks    LeadTask[]
  notes    LeadNote[]
  timeline LeadTimelineEntry[]

  loanApplications LoanApplication[]

  @@index([stage])
  @@index([agentId])
  @@index([createdAt])
  // Revenue reporting filters on closedAt (period) and propertyId
  // (revenue attributed to a listing).
  @@index([closedAt])
  @@index([propertyId])
}

// Status: PENDING, IN_PROGRESS, DONE
model LeadTask {
  id          String    @id @default(uuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  title       String
  description String?
  assignedTo  String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Type: CREATED, STAGE_CHANGE, NOTE, TASK, CALL, MEETING
model LeadTimelineEntry {
  id          String   @id @default(uuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  author      String?
  createdAt   DateTime @default(now())
}

// ============================================================
// Loan applications — the single store for "Check Your Loan
// Eligibility" submissions. The public website form and the CRM's
// "New application" form both go through src/lib/loanApplications.ts, so
// they land in this same table (and the same Lead) with no duplicates.
//
// status: NEW, DOCS_PENDING, DOCS_COMPLETE, IN_PROCESS, APPROVED,
// REJECTED, CLOSED. (The website had no statuses before — it only
// created a Lead — so this set is new.)
// applicantType: "Salaried" | "Self Employed" (matches the website form).
// source: "Website" | "CRM".
// ============================================================
model LoanApplication {
  id            String         @id @default(uuid())
  name          String
  phone         String
  email         String
  applicantType String
  status        String         @default("NEW")
  source        String         @default("Website")
  notes         String?
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  documents     LoanDocument[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([phone])
  @@index([leadId])
  @@index([createdAt])
}

model LoanDocument {
  id            String          @id @default(uuid())
  applicationId String
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  key           String // stable id from src/lib/loanDocuments.ts
  label         String
  received      Boolean         @default(false)
  receivedAt    DateTime?
  fileUrl       String?

  @@unique([applicationId, key])
}

// ============================================================
// Locality — the single, admin-editable list of Bengaluru areas used by
// the website's location filter AND every CRM picker (Add/Edit Property,
// lead forms, Excel import). Seeded from src/lib/bengaluruLocalities.ts
// (prisma/seed-localities.ts). Property.location / Lead.location stay
// free text so legacy values keep loading; matching is by name.
// zone: North | South | East | West | Central (optional).
// ============================================================
model Locality {
  id        String   @id @default(uuid())
  name      String   @unique
  zone      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
